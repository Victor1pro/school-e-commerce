# ==========================
# DATABASE CONFIG
# ==========================
APP_DATABASE_URL="sqlite:///./GLH.db"


# ==========================
# APP ENVIRONMENT
# ==========================
# development | staging | production
APP_ENVIRONMENT="development"


# ==========================
# JWT ALGORITHM
# ==========================
APP_JWT_ALGORITHM="HS256"


# ==========================
# USER JWT SECRETS
# ==========================
# Used ONLY for normal users
APP_USER_ACCESS_TOKEN_SECRET_KEY="6f132ced6ebaff83f0da44ebad68a68a35d1f71b89ea527a03ecbc003ad14faf6938225329c1d1769f88b67660f632a749c0c368b1ea579c6be0c8cf88c1350a"
APP_USER_REFRESH_TOKEN_SECRET_KEY="aacbe6f16d0408437969f27ed46fe80b42c6706471bab2f1842c4f2cd2aa4cb953f66fd5d97e232ffef733d196a7a171ff0499f00fddf8629e1f442d21be5ae9"


# ==========================
# ADMIN JWT SECRETS (NEW)
# ==========================
# Used ONLY for admin accounts
# MUST be different from user secrets
APP_ADMIN_ACCESS_TOKEN_SECRET_KEY="79b0daee70688a2ff29c745ebf7c61374ccbadd7980e0fbf7056339f8a16f5eb08f6646787b9780c2a9f399950aae4c2e4bf7d1c13fd4069870f69e688923c33"
APP_ADMIN_REFRESH_TOKEN_SECRET_KEY="3cd5f503ce647b1de1da7101ce0d1b397e5323c182c229bb02ef76e2325c3c968c47a697bc57415c1c4b6ab79d2587edb2b40bfdba947aabcc4465a050821ab9"


# ==========================
# USER TOKEN EXPIRATION
# ==========================
APP_USER_ACCESS_TOKEN_EXPIRE_MINUTES=15
APP_USER_REFRESH_TOKEN_EXPIRE_DAYS=30


# ==========================
# ADMIN TOKEN EXPIRATION (SHORTER!)
# ==========================
APP_ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=10
APP_ADMIN_REFRESH_TOKEN_EXPIRE_DAYS=7


# ==========================
# SESSION EXPIRATION (OPTIONAL)
# ==========================
APP_SESSION_EXPIRE_MINUTES=15
APP_SESSION_EXPIRE_DAYS=30


# ==========================
# REDIS CONFIG (FUTURE USE)
# ==========================
# Used for:
# - Token revocation
# - Session tracking
# - Admin forced logout
# - Rate limiting
REDIS_ENABLED=false
REDIS_URL="redis://localhost:6379/0"
REDIS_PREFIX="glh"


# ==========================
# SECURITY HARDENING (OPTIONAL)
# ==========================
# Force HTTPS cookies in production
SECURE_COOKIES=false

# Allow multiple concurrent sessions per user
ALLOW_MULTI_SESSIONS=true